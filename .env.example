# Copy to .env and fill in. Never commit .env.

# Your Claude API key (console.anthropic.com). Pays for the films.
ANTHROPIC_API_KEY=

# Who can log in: name:password pairs, comma-separated.
FRIENDS=raj:change-me,anu:change-me-too

# Random string, 16+ characters (e.g. `openssl rand -hex 32`). Signs login cookies.
SESSION_SECRET=

# Claude model for the film agent, and the hard cost cap per film in USD.
CLAUDE_MODEL=claude-opus-5-5
MAX_BUDGET_USD=15
MAX_TURNS=400

# Fair use: films per friend per 24 h (0 = no limit), films made at the same time.
FILMS_PER_DAY=2
CONCURRENCY=1

# 1 = test mode: no Claude, renders a 6-second pipeline check for free.
MOCK_AGENT=0

# 1 when the site is served over HTTPS (marks the login cookie Secure).
COOKIE_SECURE=0
